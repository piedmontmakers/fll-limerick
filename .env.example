# Vercel AI Gateway API Key
# Get your key from: https://vercel.com/dashboard
VITE_AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here

# Google Sheet ID for team list (optional)
# Extract from Google Sheet URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# Sheet must be publicly accessible and have columns: Team Number (A), Team Name (B)
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here
